import os

USUARIOS_FILE = "usuarios.txt"

def registrar_usuario():
    print("\n--- Registro ---")
    nombres = input("Nombres y Apellidos: ")
    identificacion = input("Identificación: ")
    edad = input("Edad: ")
    usuario = input("Correo (ej. nombre.apellido@gmail.com): ")
    contraseña = input("Contraseña: ")

    if not validar_contraseña(contraseña):
        print(" Contraseña insegura. Debe tener al menos una mayúscula, una minúscula y un número.")
        return False

    with open(USUARIOS_FILE, "a") as f:
        f.write(f"{usuario},{contraseña},{nombres},{identificacion},{edad}\n")

    print(" Registro exitoso.")
    return True

def iniciar_sesion():
    print("\n--- Inicio de sesión ---")
    usuario = input("Correo: ")
    contraseña = input("Contraseña: ")

    if not os.path.exists(USUARIOS_FILE):
        print(" No hay usuarios registrados aún.")
        return None

    with open(USUARIOS_FILE, "r") as f:
        for linea in f:
            datos = linea.strip().split(",")
            if datos[0] == usuario and datos[1] == contraseña:
                print(" Inicio de sesión exitoso.")
                return usuario
    print(" Usuario o contraseña incorrectos.")
    return None

def validar_contraseña(clave):
    tiene_mayuscula = any(c.isupper() for c in clave)
    tiene_minuscula = any(c.islower() for c in clave)
    tiene_numero = any(c.isdigit() for c in clave)
    return tiene_mayuscula and tiene_minuscula and tiene_numero
