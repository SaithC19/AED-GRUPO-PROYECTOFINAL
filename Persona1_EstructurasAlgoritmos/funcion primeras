def mostrar_matriz_costos_y_distancias(grafo):
    ciudades = list(grafo.vertices.keys())

    # Encabezado
    print("\nMATRIZ DE DISTANCIAS Y COSTOS (origen → destino)")
    print(f"{'':15}", end="")
    for destino in ciudades:
        print(f"{destino:15}", end="")
    print("\n" + "-" * (16 * (len(ciudades) + 1)))

    for origen in ciudades:
        print(f"{origen:15}", end="")
        for destino in ciudades:
            if origen == destino:
                print(f"{'---':15}", end="")
            else:
                ruta = grafo.obtener_ruta(origen, destino)
                if ruta:
                    distancia_total = sum(
                        grafo.vertices[ruta[i]][ruta[i+1]]['distancia']
                        for i in range(len(ruta) - 1)
                    )
                    costo_total = sum(
                        grafo.vertices[ruta[i]][ruta[i+1]]['costo']
                        for i in range(len(ruta) - 1)
                    )
                    print(f"D:{distancia_total} C:{costo_total}", end="  ")
                else:
                    print(f"{'No hay ruta':15}", end="")
        print()

